# Copy to .env and fill in real values before `docker compose up`.

ENVIRONMENT=development

# --- Security --------------------------------------------------------------
SECRET_KEY=1c3fc57340b6b50efb37bc441443172b101985eb6461b0b5e4d0a5db4671c737
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- CORS --------------------------------------------------------------------
CORS_ORIGINS=["http://localhost:5173"]

# --- Database ----------------------------------------------------------------
DATABASE_URL=postgresql+psycopg2://pds_user:pds_pass@postgres:5432/pds_db

# --- Redis ---------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Detection pipeline tuning (mirrors write-up's Section 9 decision tree) --
DETECTION_CONFIDENCE_THRESHOLD=0.5
LOW_LIGHT_CONFIDENCE_THRESHOLD=0.4
SAFE_DISTANCE_METERS=3.0
CLOSING_SPEED_CRITICAL_MPS=2.0
TARGET_FPS=15

# --- Model registry ------------------------------------------------------------
MODEL_WEIGHTS_DIR=/models
ACTIVE_MODEL_NAME=yolov8n-pedestrian

# --- Data retention (NFR-07, Ghana Data Protection Act 2012 / Act 843) -------
FOOTAGE_RETENTION_DAYS=30
